<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#102b34" />
    <title>@ViewData["Title"] · Dist-O-Meter</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="shell nav-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Dist-O-Meter, home"><span class="brand-symbol" aria-hidden="true">◈</span> DIST<span>O</span>METER</a>
            <nav aria-label="Main navigation"><a asp-controller="Home" asp-action="Index" asp-fragment="metode">How it works</a><a class="nav-button" asp-controller="Home" asp-action="Index" asp-fragment="maaling">Start measuring <span aria-hidden="true">↗</span></a></nav>
        </div>
    </header>
    <main id="main-content">@RenderBody()</main>
    <footer class="site-footer"><div class="shell footer-inner"><strong>DIST<span>O</span>METER</strong><p>Precise distance measurements from a safe reference point.</p><small>© @DateTime.Now.Year Dist-O-Meter</small></div></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
